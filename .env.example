# Copy this file to .env and fill in your local values.
# .env is git-ignored — never commit it.

# Absolute path to the root directory that your templates use as a prefix
# in {% extends %} and {% include %} expressions, with a trailing slash.
#
# Example:
#   TEMPLATE_BASE_PATH=/Users/yourname/projects/myapp/src/templates/
#
# Matches the basePath variable used in templates like:
#   {% extends basePath + "layouts/base.njk" %}
#   {% include basePath + "partials/header.njk" %}
TEMPLATE_BASE_PATH=
