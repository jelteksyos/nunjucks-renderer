<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default("Untitled") }}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: system-ui, sans-serif;
      background: #f5f5f5;
      color: #222;
      padding: 2rem;
      line-height: 1.6;
    }

    header {
      margin-bottom: 2rem;
      border-bottom: 2px solid #ddd;
      padding-bottom: 1rem;
    }

    header h1 { font-size: 1.8rem; }
    header p  { color: #555; margin-top: .25rem; }

    .card {
      background: #fff;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      padding: 1.25rem 1.5rem;
      margin-bottom: 1.5rem;
    }

    .card h2 { font-size: 1rem; text-transform: uppercase;
               letter-spacing: .05em; color: #888; margin-bottom: .75rem; }

    .badge {
      display: inline-block;
      background: #e8f0fe;
      color: #3b5bdb;
      border-radius: 4px;
      padding: .15rem .5rem;
      font-size: .85rem;
      margin-left: .5rem;
    }

    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: .5rem .75rem; border-bottom: 1px solid #eee; }
    th { color: #888; font-weight: 600; font-size: .85rem; }

    .missing { color: #aaa; font-style: italic; }
  </style>
</head>
<body>

  {% include basePath ~ "partials/_banner.njk" %}

  {# -----------------------------------------------------------------------
     Header — uses | default() so an empty title never leaves a blank <h1>
  ----------------------------------------------------------------------- #}
  <header>
    <h1>{{ title | default("Untitled page") }}</h1>
    <p>{{ description | default("No description provided.") }}</p>
  </header>

  {# -----------------------------------------------------------------------
     User card — safe even if the entire `user` object is missing
  ----------------------------------------------------------------------- #}
  <section class="card">
    <h2>Current user</h2>

    {% if user %}
      <p>
        <strong>{{ user.name | default("Anonymous") }}</strong>
        <span class="badge">{{ user.role | default("no role") }}</span>
      </p>
      {# user.avatar is absent in mock.js — renders fallback, no crash #}
      <p style="margin-top:.5rem">
        Avatar: <span class="{{ 'missing' if not user.avatar }}">
          {{ user.avatar | default("(none set)") }}
        </span>
      </p>
    {% else %}
      <p class="missing">No user in context.</p>
    {% endif %}
  </section>

  {# -----------------------------------------------------------------------
     Items table — safe when `items` is empty or missing
  ----------------------------------------------------------------------- #}
  <section class="card">
    <h2>Items</h2>

    {% if items and items | length > 0 %}
      <table>
        <thead>
          <tr><th>#</th><th>Label</th><th>Count</th></tr>
        </thead>
        <tbody>
          {% for item in items %}
            <tr>
              <td>{{ loop.index }}</td>
              <td>{{ item.label | default("—") }}</td>
              <td>{{ item.count | default("0") }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p class="missing">No items to display.</p>
    {% endif %}
  </section>

  {# -----------------------------------------------------------------------
     Missing field demo — `missingField` is not in mock.js
     This proves the setup never crashes on undefined variables.
  ----------------------------------------------------------------------- #}
  <section class="card">
    <h2>Safe undefined demo</h2>
    <p>
      <code>missingField</code> is not in mock.js →
      "<span class="missing">{{ missingField | default("(undefined — rendered safely)") }}</span>"
    </p>
    <p style="margin-top:.5rem">
      <code>ghost.nested.deep</code> (fully absent object) →
      "<span class="missing">{{ ghost.nested.deep | default("(also safe)") }}</span>"
    </p>
  </section>

  {% include "_footer.njk" %}

</body>
</html>
